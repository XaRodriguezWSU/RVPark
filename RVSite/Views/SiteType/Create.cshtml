@model RVSite.Models.SiteType

@{
    ViewData["Title"] = "Create Site Type";
}

<section class="card admin-hero mb-4">
    <div class="card-body p-4 p-lg-5">
        <span class="home-kicker">Site Configuration</span>

        <h1 class="page-title">Create Site Type</h1>

        <p class="page-subtitle mb-0">
            Add a new campsite category that can be assigned to RV sites.
        </p>
    </div>
</section>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <section class="card">
            <div class="card-header">
                <h2 class="h5 mb-0">Site Type Details</h2>
            </div>

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div>
                        <label asp-for="Name"
                               class="form-label">
                            Site Type Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Example: Premium Pull-Through" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Use a clear name that employees and customers will recognize.
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white">
                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            Create Site Type
                        </button>
                    </div>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}