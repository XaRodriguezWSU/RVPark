@using RVSite.Models

@{
    ViewData["Title"] = "Admin Dashboard";

    var recentSites =
        ViewBag.RecentSites as List<Site>
        ?? new List<Site>();
}

<section class="card admin-hero mb-4">
    <div class="card-body p-4 p-lg-5">

        <div class="d-flex flex-column flex-lg-row
                    justify-content-between
                    align-items-lg-center
                    gap-3">

            <div>
                <span class="home-kicker">
                    Administration
                </span>

                <h1 class="page-title mb-2">
                    Admin Dashboard
                </h1>

                <p class="page-subtitle mb-0">
                    Oversee campground operations, reservations,
                    employees, pricing, policies, and reporting.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="Reservation"
                   asp-action="Search"
                   class="btn btn-primary">
                    Search Reservations
                </a>

                <a asp-controller="Admin"
                   asp-action="Reports"
                   class="btn btn-outline-secondary">
                    Generate Reports
                </a>

            </div>

        </div>

    </div>
</section>

<section class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <span>Total Sites</span>

                <strong>
                    @ViewBag.TotalSites
                </strong>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <span>Available Sites</span>

                <strong class="text-success">
                    @ViewBag.AvailableSites
                </strong>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <span>Reserved Sites</span>

                <strong class="text-warning">
                    @ViewBag.ReservedSites
                </strong>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <span>Open Maintenance Tasks</span>

                <strong class="text-danger">
                    @ViewBag.MaintenanceSites
                </strong>
            </div>
        </div>
    </div>

</section>

<section class="row g-4 mb-4">

    <div class="col-xl-8">

        <div class="card admin-table-card h-100">

            <div class="card-header">
                <div class="d-flex flex-column flex-sm-row
                            justify-content-between
                            align-items-sm-center
                            gap-2">

                    <div>
                        <h2 class="h5 mb-1">
                            Site Overview
                        </h2>

                        <p class="text-muted mb-0">
                            Current campground inventory and operating status.
                        </p>
                    </div>

                    <a asp-controller="Sites"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary">
                        Manage All Sites
                    </a>

                </div>
            </div>

            <div class="card-body p-0">

                @if (recentSites.Any())
                {
                <div class="table-responsive">

                    <table class="table table-hover
                                      align-middle
                                      admin-table
                                      mb-0">

                        <thead>
                            <tr>
                                <th>Site</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Max RV Length</th>
                                <th>Base Rate</th>
                                <th class="text-end">
                                    Action
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var site in recentSites)
                                {
                            <tr>

                                <td class="fw-bold">
                                    @site.SiteNumber
                                </td>

                                <td>
                                    @(site.SiteType?.Name ?? "Not assigned")
                                </td>

                                <td>

                                    @if (site.SiteStatus ==
                                                 SiteStatus.Available.ToString())
                                            {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                            }
                                            else if (site.SiteStatus ==
                                                     SiteStatus.Reserved.ToString())
                                            {
                                    <span class="badge bg-warning text-dark">
                                        Reserved
                                    </span>
                                            }
                                            else if (site.SiteStatus ==
                                                     SiteStatus.Maintenance.ToString())
                                            {
                                    <span class="badge bg-danger">
                                        Maintenance
                                    </span>
                                            }
                                            else
                                            {
                                    <span class="badge bg-secondary">
                                        @site.SiteStatus
                                    </span>
                                            }

                                </td>

                                <td>
                                    @if (site.MaxRVLength > 0)
                                            {
                                    @($"{site.MaxRVLength} ft")
                                            }
                                            else
                                            {
                                    <span class="text-muted">
                                        N/A
                                    </span>
                                            }
                                </td>

                                <td class="fw-semibold">
                                    @site.BaseRate.ToString("C")
                                </td>

                                <td class="text-end">

                                    <a asp-controller="Sites"
                                       asp-action="Edit"
                                       asp-route-id="@site.SiteID"
                                       class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>

                                </td>

                            </tr>
                                }

                        </tbody>

                    </table>

                </div>
                }
                else
                {
                <div class="text-center p-5">

                    <h3 class="h5 mb-2">
                        No sites found
                    </h3>

                    <p class="text-muted mb-3">
                        Add a campsite to begin managing campground inventory.
                    </p>

                    <a asp-controller="Sites"
                       asp-action="Create"
                       class="btn btn-primary">
                        Add Site
                    </a>

                </div>
                }

            </div>

        </div>

    </div>

    <div class="col-xl-4">

        <div class="card h-100">

            <div class="card-header">
                <h2 class="h5 mb-0">
                    Admin Quick Actions
                </h2>
            </div>

            <div class="card-body">

                <div class="d-grid gap-2">

                    <a asp-controller="Reservation"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Reservations
                    </a>

                    <a asp-controller="Sites"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Manage Sites
                    </a>

                    <a asp-controller="Admin"
                       asp-action="Employees"
                       class="btn btn-outline-secondary">
                        Manage Employees
                    </a>

                    <a asp-controller="Admin"
                       asp-action="CreateEmployee"
                       class="btn btn-outline-secondary">
                        Create Employee Account
                    </a>

                    <a asp-controller="Maintenance"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Maintenance Tasks
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="row g-4">

    <div class="col-md-6 col-xl-3">

        <div class="card h-100">

            <div class="card-header">
                <h2 class="h5 mb-0">
                    Reservations & Reporting
                </h2>
            </div>

            <div class="card-body d-grid gap-2">

                <a asp-controller="Reservation"
                   asp-action="Search"
                   class="btn btn-outline-primary">
                    Search Reservations
                </a>

                <a asp-controller="Admin"
                   asp-action="Reports"
                   class="btn btn-outline-secondary">
                    Generate Reports
                </a>

                <a asp-controller="Admin"
                   asp-action="ReservationPolicies"
                   class="btn btn-outline-secondary">
                    Reservation Policies
                </a>

            </div>

        </div>

    </div>

    <div class="col-md-6 col-xl-3">

        <div class="card h-100">

            <div class="card-header">
                <h2 class="h5 mb-0">
                    Campground Configuration
                </h2>
            </div>

            <div class="card-body d-grid gap-2">

                <a asp-controller="Sites"
                   asp-action="Create"
                   class="btn btn-outline-primary">
                    Add New Site
                </a>

                <a asp-controller="SiteType"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Site Types & Pricing
                </a>

                <a asp-controller="Fees"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Manage Fees
                </a>

            </div>

        </div>

    </div>

    <div class="col-md-6 col-xl-3">

        <div class="card h-100">

            <div class="card-header">
                <h2 class="h5 mb-0">
                    Staff Management
                </h2>
            </div>

            <div class="card-body d-grid gap-2">

                <a asp-controller="Admin"
                   asp-action="Employees"
                   class="btn btn-primary">
                    Manage Employees
                </a>

                <a asp-controller="Admin"
                   asp-action="CreateEmployee"
                   class="btn btn-outline-primary">
                    Create Employee Account
                </a>

                <a asp-controller="Maintenance"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Maintenance Tasks
                </a>

            </div>

        </div>

    </div>

    <div class="col-md-6 col-xl-3">

        <div class="card h-100">

            <div class="card-header">
                <h2 class="h5 mb-0">
                    Site Media
                </h2>
            </div>

            <div class="card-body d-flex flex-column">

                <p class="text-muted">
                    Preview, upload, and maintain photos used throughout
                    customer-facing campsite listings.
                </p>

                <a asp-controller="SitePhoto"
                   asp-action="Manage"
                   class="btn btn-outline-primary mt-auto">
                    Manage Site Photos
                </a>

            </div>

        </div>

    </div>

</section>