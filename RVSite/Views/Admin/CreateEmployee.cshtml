@{
    ViewData["Title"] = "Create Employee";
}

<div class="card-body">
    <form asp-action="CreateEmployee" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger"></div>
        }

        <div class="row g-3">

            <div class="col-md-6">
                <label for="firstName" class="form-label">
                    First Name
                </label>

                <input type="text"
                       name="firstName"
                       id="firstName"
                       value="@ViewBag.FirstName"
                       class="form-control"
                       required />
            </div>


            <div class="col-md-6">
                <label for="lastName" class="form-label">
                    Last Name
                </label>

                <input type="text"
                       name="lastName"
                       id="lastName"
                       value="@ViewBag.LastName"
                       class="form-control"
                       required />
            </div>


            <div class="col-md-6">
                <label for="email" class="form-label">
                    Email
                </label>

                <input type="email"
                       name="email"
                       id="email"
                       value="@ViewBag.Email"
                       class="form-control"
                       required />
            </div>


            <div class="col-md-6">
                <label for="phoneNumber" class="form-label">
                    Phone Number
                </label>

                <input type="text"
                       name="phoneNumber"
                       id="phoneNumber"
                       value="@ViewBag.PhoneNumber"
                       class="form-control"
                       required />
            </div>


            <div class="col-md-6">
                <label for="selectedRoleID" class="form-label">
                    Role
                </label>

                <select name="selectedRoleID"
                        id="selectedRoleID"
                        class="form-select"
                        required>

                    <option value="">
                        -- Select Role --
                    </option>

                    @foreach (var role in ViewBag.AvailableRoles)
                    {
                        if (ViewBag.SelectedRoleID != null &&
                            (int)ViewBag.SelectedRoleID == role.RoleID)
                        {
                            <option value="@role.RoleID" selected>
                                @role.Type
                            </option>
                        }
                        else
                        {
                            <option value="@role.RoleID">
                                @role.Type
                            </option>
                        }
                    }

                </select>
            </div>


            <div class="col-md-6">
                <label for="password" class="form-label">
                    Temporary Password
                </label>

                <input type="password"
                       name="password"
                       id="password"
                       class="form-control"
                       minlength="8"
                       required />

                <small class="text-muted">
                    Password must be at least 8 characters.
                </small>
            </div>

        </div>


        <div class="d-flex gap-2 mt-4">

            <button type="submit"
                    class="btn btn-primary">
                Create Account
            </button>

            <a asp-action="Employees"
               class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>
</div>