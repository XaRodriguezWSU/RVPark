@model RVSite.Models.SiteTypePrice

@{
    ViewData["Title"] = "Delete Price Range";
}

<section class="card admin-hero mb-4">
    <div class="card-body p-4 p-lg-5">
        <span class="home-kicker">Seasonal Pricing</span>

        <h1 class="page-title">Delete Price Range</h1>

        <p class="page-subtitle mb-0">
            Review this pricing period before permanently removing it.
        </p>
    </div>
</section>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <section class="card border-danger">
            <div class="card-header bg-danger-subtle border-danger">
                <h2 class="h5 mb-0 text-danger">
                    Confirm Deletion
                </h2>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-warning">
                    <strong>This action cannot be undone.</strong>
                    Deleting this range may change the rate used for future reservations.
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="detail-box">
                            <span class="detail-label">Start Date</span>

                            <strong>
                                @Model.StartDate.ToString("MMMM d, yyyy")
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-box">
                            <span class="detail-label">End Date</span>

                            <strong>
                                @(Model.EndDate?.ToString("MMMM d, yyyy") ?? "Current")
                            </strong>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="detail-box">
                            <span class="detail-label">Nightly Rate</span>

                            <strong class="fs-5">
                                @Model.Price.ToString("C")
                            </strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white">
                <form asp-action="Delete"
                      asp-route-id="@Model.SiteTypePriceID"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="SiteTypePriceID" />

                    <input type="hidden"
                           asp-for="SiteTypeID" />

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                        <a asp-action="Index"
                           asp-route-siteTypeId="@Model.SiteTypeID"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-danger px-4">
                            Delete Price Range
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>