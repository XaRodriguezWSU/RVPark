@model RVSite.Models.SiteTypePrice

@{
    ViewData["Title"] = "Edit Price Range";
}

<section class="card admin-hero mb-4">
    <div class="card-body p-4 p-lg-5">
        <span class="home-kicker">Seasonal Pricing</span>

        <h1 class="page-title">Edit Price Range</h1>

        <p class="page-subtitle mb-0">
            Update the effective dates or nightly rate for this pricing period.
        </p>
    </div>
</section>

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <section class="card">
            <div class="card-header">
                <h2 class="h5 mb-0">Pricing Details</h2>
            </div>

            <form asp-action="Edit"
                  asp-route-id="@Model.SiteTypePriceID"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="SiteTypePriceID" />

                <input type="hidden"
                       asp-for="SiteTypeID" />

                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate"
                                   class="form-label">
                                Start Date
                            </label>

                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="StartDate"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate"
                                   class="form-label">
                                End Date
                                <span class="text-muted fw-normal">
                                    (optional)
                                </span>
                            </label>

                            <input asp-for="EndDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="EndDate"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Price"
                                   class="form-label">
                                Nightly Rate
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">$</span>

                                <input asp-for="Price"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control" />
                            </div>

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="alert alert-light border mt-4 mb-0">
                        Verify that this range does not conflict with another pricing
                        range for the same site type.
                    </div>
                </div>

                <div class="card-footer bg-white">
                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                        <a asp-action="Index"
                           asp-route-siteTypeId="@Model.SiteTypeID"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            Save Changes
                        </button>
                    </div>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}